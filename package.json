{
  "name": "mycat-cloudflare-d1",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run db:migrate:remote && wrangler deploy",
    "db:create": "wrangler d1 create mycat-db",
    "db:migrate:local": "wrangler d1 migrations apply mycat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mycat-db --remote",
    "db:migrations:list": "wrangler d1 migrations list mycat-db --remote",
    "test": "node --check src/index.js && node --check public/assets/app.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
